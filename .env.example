# Copia este archivo a .env y ajusta los valores.

# PostgreSQL (el contenedor de db/db.sh escucha en el 5433 para no chocar con un Postgres local)
DATABASE_URL=postgres://fatfit:fatfit_dev@localhost:5433/fatfit

# JWT: cambia el secreto en cualquier entorno que no sea tu máquina
JWT_SECRETO=cambia-este-secreto-de-desarrollo
JWT_EXPIRA=1h
# Clave con la que los servicios se llaman entre sí (borrado de cuenta)
CLAVE_INTERNA=cambia-esta-clave-interna

# Zona horaria para decidir qué día es "hoy"
TZ=America/Mexico_City

# Puertos
PUERTO_GATEWAY=3000
PUERTO_AUTH=3001
PUERTO_SALUD=3002
PUERTO_ENTRENAMIENTO=3003
PUERTO_NUTRICION=3004
PUERTO_FATI=3005

# Fati (LLM). Sin llave, Fati responde con plantillas basadas en los cálculos.
ANTHROPIC_API_KEY=
FATI_MODELO=claude-opus-5-5

# ---------- Despliegue ----------
# URL con la que el front alcanza el gateway. Deja vacío en desarrollo.
URL_PUBLICA=
# Orígenes web permitidos, separados por comas. Vacío = cualquiera (solo desarrollo).
ORIGENES_CORS=
# Contraseña de PostgreSQL cuando se usa docker-compose.yml
POSTGRES_PASSWORD=fatfit_dev
# production oculta el token de recuperación de contraseña en las respuestas
NODE_ENV=development
