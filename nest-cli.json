{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "webpack",
    "tsConfigPath": "apps/gateway/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "introspectComments": true,
          "classValidatorShim": true
        }
      }
    ]
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "salud": {
      "type": "application",
      "root": "apps/salud",
      "entryFile": "main",
      "sourceRoot": "apps/salud/src",
      "compilerOptions": {
        "tsConfigPath": "apps/salud/tsconfig.app.json"
      }
    },
    "entrenamiento": {
      "type": "application",
      "root": "apps/entrenamiento",
      "entryFile": "main",
      "sourceRoot": "apps/entrenamiento/src",
      "compilerOptions": {
        "tsConfigPath": "apps/entrenamiento/tsconfig.app.json"
      }
    },
    "nutricion": {
      "type": "application",
      "root": "apps/nutricion",
      "entryFile": "main",
      "sourceRoot": "apps/nutricion/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nutricion/tsconfig.app.json"
      }
    },
    "fati": {
      "type": "application",
      "root": "apps/fati",
      "entryFile": "main",
      "sourceRoot": "apps/fati/src",
      "compilerOptions": {
        "tsConfigPath": "apps/fati/tsconfig.app.json"
      }
    },
    "comun": {
      "type": "library",
      "root": "libs/comun",
      "entryFile": "index",
      "sourceRoot": "libs/comun/src",
      "compilerOptions": {
        "tsConfigPath": "libs/comun/tsconfig.lib.json"
      }
    }
  }
}